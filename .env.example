# === Application ===
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
APP_NAME=Nexus

# === Database ===
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev@localhost:5432/nexus
DATABASE_URL_SYNC=postgresql://nexus:nexus_dev@localhost:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev
POSTGRES_DB=nexus

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Authentication ===
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# === Encryption ===
ENCRYPTION_KEY=change-me-use-fernet-key-generate

# === LLM Provider ===
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-20b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === GitHub ===
# GITHUB_CLIENT_ID/SECRET are used for the OAuth "Connect" flow on the Sources
# page. Alternatively set GITHUB_PERSONAL_ACCESS_TOKEN for direct API access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/sources/github/callback
GITHUB_PERSONAL_ACCESS_TOKEN=

# === Slack ===
# SLACK_CLIENT_ID/SECRET are used for the OAuth "Connect" flow on the Sources
# page. Alternatively set SLACK_BOT_TOKEN (xoxb-...) for direct API access.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/sources/slack/callback
SLACK_BOT_TOKEN=

# === HubSpot (Private App Access Token) ===
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/sources/hubspot/callback

# === PostgreSQL MCP ===
MCP_POSTGRES_HOST=localhost
MCP_POSTGRES_PORT=5432
MCP_POSTGRES_DB=nexus

# === Security ===
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === Observability ===
SENTRY_DSN=
LOG_LEVEL=INFO
ENABLE_METRICS=true


